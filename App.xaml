<Application x:Class="PomodoroWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PomodoroWPF.Converters">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ===== 全局字体 — 微软雅黑 ===== -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        </Style>
        <!-- ===== 颜色主题 — 极简黑金 ===== -->
        <Color x:Key="BgColor">#000000</Color>
        <Color x:Key="CardColor">#0a0a0a</Color>
        <Color x:Key="CardBorderColor">#1a1a1a</Color>
        <Color x:Key="AccentColor">#f59e0b</Color>
        <Color x:Key="AccentGlowColor">#fbbf24</Color>
        <Color x:Key="AccentDimColor">#a16207</Color>
        <Color x:Key="SuccessColor">#10b981</Color>
        <Color x:Key="SuccessDimColor">#065f46</Color>
        <Color x:Key="WarningColor">#f59e0b</Color>
        <Color x:Key="TextColor">#fafaf9</Color>
        <Color x:Key="TextDimColor">#c8c3bc</Color>
        <Color x:Key="TextMutedColor">#57534e</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="SuccessDimBrush" Color="{StaticResource SuccessDimColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    </Application.Resources>
</Application>
